# 复制为 .env 后按需修改。.env 不要提交到 git。

PORT=8787
NODE_ENV=development

# 会话签名密钥：生产环境必须改成随机长字符串（如 openssl rand -hex 32）
AUTH_SECRET=

# SQLite 数据库文件路径（默认 ./data/g7math.db）
DB_PATH=

# ---- 短信验证码（腾讯云 SMS）。留空且非生产环境时进入开发模式：验证码直接返回给前端，仅用于本地联调 ----
SMS_PROVIDER=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN=
SMS_TEMPLATE_ID=

# ---- 微信支付（里程碑 3 接入，先占位） ----
WXPAY_MCHID=
WXPAY_APPID=
WXPAY_SERIAL=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_APIV3_KEY=
WXPAY_NOTIFY_URL=
