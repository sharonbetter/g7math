page {
  background: #f7f8fa;
  font-size: 28rpx;
  color: #1f2937;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.wrap {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #eef0f3;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.muted {
  color: #9ca3af;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gap {
  height: 16rpx;
}

.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  border: 1rpx solid #e5e7eb;
  color: #6b7280;
  background: #f9fafb;
}

.badge-blue { color: #1d4ed8; background: #eff6ff; border-color: #bfdbfe; }
.badge-green { color: #15803d; background: #f0fdf4; border-color: #bbf7d0; }
.badge-red { color: #b91c1c; background: #fef2f2; border-color: #fecaca; }
.badge-amber { color: #b45309; background: #fffbeb; border-color: #fde68a; }
.badge-violet { color: #6d28d9; background: #f5f3ff; border-color: #ddd6fe; }

.btn {
  display: block;
  width: 100%;
  padding: 22rpx 0;
  border-radius: 16rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 30rpx;
  text-align: center;
  line-height: 1.2;
  border: none;
}

.btn::after { border: none; }

.btn-primary {
  background: #2563eb;
  color: #fff;
}

.btn-primary[disabled] {
  background: #bfdbfe;
  color: #eff6ff;
}

.btn-sm {
  display: inline-block;
  width: auto;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 20rpx;
  background: #fff;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 20rpx;
  background: #fff;
  font-size: 28rpx;
  min-height: 180rpx;
}

.label {
  font-size: 24rpx;
  color: #4b5563;
  margin-bottom: 10rpx;
}

.stem {
  font-size: 30rpx;
  line-height: 1.7;
  color: #111827;
  white-space: pre-wrap;
}

.solution {
  font-size: 27rpx;
  line-height: 1.7;
  color: #374151;
  white-space: pre-wrap;
}

.divider {
  height: 1rpx;
  background: #f3f4f6;
  margin: 20rpx 0;
}

.grid-num {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.num {
  width: 66rpx;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
  background: #fff;
  color: #6b7280;
  font-size: 24rpx;
}

.num-current {
  background: #2563eb;
  border-color: #2563eb;
  color: #fff;
}

.num-right { background: #f0fdf4; border-color: #bbf7d0; color: #15803d; }
.num-wrong { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
.num-pending { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }

.thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e5e7eb;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.center {
  text-align: center;
}

.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: #eef0f3;
  overflow: hidden;
}

.bar-inner {
  height: 100%;
  background: #2563eb;
}

.bar-inner-green { background: #22c55e; }
.bar-inner-amber { background: #f59e0b; }
