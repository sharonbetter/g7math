.intro {
  line-height: 1.7;
  margin-top: 12rpx;
}

/* 等级 */
.lv-summary {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.lv-medal {
  width: 130rpx;
  height: 130rpx;
  border-radius: 28rpx;
  background: #2563eb;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.lv-medal-cap { font-size: 20rpx; opacity: 0.8; }
.lv-medal-num { font-size: 52rpx; font-weight: 600; line-height: 1.1; }

.lv-main { flex: 1; min-width: 0; }
.lv-name { font-size: 32rpx; font-weight: 600; }
.lv-nums { margin: 8rpx 0; }
.lv-nums .muted { font-size: 22rpx; }
.lv-next { margin-top: 8rpx; font-size: 22rpx; }

.lv-ladder { margin-top: 28rpx; }

.lv-row-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-top: 1rpx solid #f3f4f6;
}

.lv-row-dot {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 22rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.lv-row-reached .lv-row-dot { background: #dbeafe; color: #1d4ed8; }
.lv-row-cur { background: #2563eb !important; color: #fff !important; }

.lv-row-body { flex: 1; min-width: 0; }
.lv-row-name { font-size: 28rpx; font-weight: 600; }
.lv-row-locked { color: #9ca3af; }

.lv-row-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: #2563eb;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  font-weight: 400;
}

/* 徽章 */
.ach-count { font-size: 32rpx; font-weight: 600; color: #d97706; }
.ach-total { color: #9ca3af; font-weight: 400; }

.badge-wall {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.badge-item {
  width: 48%;
  box-sizing: border-box;
  margin-right: 2%;
  margin-bottom: 14rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 18rpx;
}

.badge-earned {
  border-color: #fde68a;
  background: #fffbeb;
}

.badge-locked {
  background: #f9fafb;
}

.badge-icon { font-size: 40rpx; }
.badge-icon-locked { opacity: 0.3; }

.badge-name {
  font-size: 26rpx;
  font-weight: 600;
  margin: 6rpx 0 4rpx 0;
}
