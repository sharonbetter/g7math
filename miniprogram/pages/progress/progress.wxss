.intro {
  line-height: 1.7;
  margin-top: 12rpx;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.stat {
  width: 50%;
  box-sizing: border-box;
  padding: 0 6rpx 12rpx 0;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.stat-num.blue { color: #2563eb; }
.stat-num.green { color: #16a34a; }
.stat-num.red { color: #dc2626; }
.stat-num.amber { color: #d97706; }
.stat-num.small { font-size: 30rpx; }

.prog {
  margin-top: 20rpx;
}

.empty-tip {
  margin-top: 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #f3f4f6;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-top: 12rpx;
}

.list-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.list-title {
  font-size: 27rpx;
  color: #374151;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.list-sub {
  margin-top: 6rpx;
}

.more-tip {
  margin-top: 16rpx;
}

.btn-danger {
  color: #b91c1c;
}
