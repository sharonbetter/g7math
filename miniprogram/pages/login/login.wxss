.login-wrap {
  padding-top: 120rpx;
}

.brand {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.brand-icon {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: #2563eb;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-right: 18rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 600;
}

.login-tip {
  line-height: 1.7;
  margin-bottom: 30rpx;
}

.login-field {
  margin-bottom: 28rpx;
}

.login-error {
  color: #b91c1c;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.login-btn {
  margin-top: 10rpx;
}

.login-note {
  margin-top: 24rpx;
  line-height: 1.6;
}
