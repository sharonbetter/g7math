.hero {
  background: #2563eb;
  border-radius: 20rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.hero-desc {
  color: #dbeafe;
  font-size: 24rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.stat {
  width: 50%;
  box-sizing: border-box;
  padding: 0 6rpx 12rpx 0;
}

.stat:only-child {
  width: 100%;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.stat-num.blue { color: #2563eb; }
.stat-num.green { color: #16a34a; }

.step {
  display: flex;
  margin-top: 18rpx;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 22rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.step-text {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.65;
}

.strong {
  color: #111827;
  font-weight: 600;
}

.prog {
  margin-top: 20rpx;
}

.empty-tip {
  margin-top: 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #f3f4f6;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-top: 12rpx;
}

.list-title {
  font-size: 27rpx;
  color: #374151;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.list-right {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.list-right .badge {
  margin-left: 12rpx;
}

.vol {
  margin-top: 20rpx;
}

.vol-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #374151;
}

.user-line {
  margin-top: 12rpx;
}
