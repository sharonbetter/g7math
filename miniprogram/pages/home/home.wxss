.hero {
  background: #2563eb;
  border-radius: 20rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.hero-desc {
  color: #dbeafe;
  font-size: 24rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.stat {
  width: 50%;
  box-sizing: border-box;
  padding: 0 6rpx 12rpx 0;
}

.stat:only-child {
  width: 100%;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.stat-num.blue { color: #2563eb; }
.stat-num.green { color: #16a34a; }

.step {
  display: flex;
  margin-top: 18rpx;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 22rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.step-text {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.65;
}

.strong {
  color: #111827;
  font-weight: 600;
}

.prog {
  margin-top: 20rpx;
}

.empty-tip {
  margin-top: 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #f3f4f6;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-top: 12rpx;
}

.list-title {
  font-size: 27rpx;
  color: #374151;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.list-right {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.list-right .badge {
  margin-left: 12rpx;
}

.vol {
  margin-top: 20rpx;
}

.vol-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #374151;
}

/* 等级面板：渐变底，突出当前等级 */
.lv-panel {
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.25);
}

.lv-panel-top {
  padding: 30rpx 32rpx;
}

.lv-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lv-panel-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.lv-panel-cap {
  color: #dbeafe;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.lv-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.lv-medal {
  width: 180rpx;
  height: 180rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.lv-medal-cap {
  font-size: 22rpx;
  color: #dbeafe;
  letter-spacing: 4rpx;
  line-height: 1;
}

.lv-medal-num {
  font-size: 84rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
}

.lv-main {
  flex: 1;
  min-width: 0;
}

.lv-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.lv-xp {
  font-size: 24rpx;
  color: #dbeafe;
  margin-top: 6rpx;
}

.lv-bar {
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  overflow: hidden;
  margin-top: 16rpx;
}

.lv-bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: #fff;
}

.lv-bar-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #dbeafe;
}

.lv-bar-hint {
  color: #fff;
  font-weight: 600;
}

/* 等级节点轨 */
.lv-rail-wrap {
  background: rgba(0, 0, 0, 0.16);
  padding: 24rpx 32rpx;
}

.lv-rail {
  display: flex;
  align-items: flex-start;
}

.lv-node {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lv-dot {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  color: rgba(219, 234, 254, 0.7);
  font-size: 22rpx;
  font-weight: 600;
}

.lv-dot-reached {
  background: rgba(255, 255, 255, 0.82);
  color: #1d4ed8;
}

.lv-dot-current {
  background: #fff;
  color: #1d4ed8;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.25);
}

.lv-node-name {
  margin-top: 10rpx;
  font-size: 18rpx;
  color: rgba(219, 234, 254, 0.65);
  text-align: center;
  line-height: 1.2;
}

.lv-node-cur-name {
  color: #fff;
  font-weight: 600;
}

.lv-bottom {
  background: #fff;
  padding: 26rpx 32rpx 30rpx 32rpx;
}

.lv-stats {
  display: flex;
}

.lv-stat {
  flex: 1;
  border: 1rpx solid #eef0f3;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-right: 18rpx;
}

.lv-stat:last-child {
  margin-right: 0;
}

.lv-stat-num {
  font-size: 48rpx;
  font-weight: 700;
  margin: 8rpx 0 12rpx 0;
  color: #111827;
}

.lv-stat-num.green { color: #16a34a; }
.lv-stat-num.amber { color: #d97706; }

.lv-stat-sub {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 400;
}

.lv-tip {
  margin-top: 20rpx;
  line-height: 1.6;
}

/* 徽章 */
.ach-count {
  font-size: 44rpx;
  font-weight: 700;
  color: #f59e0b;
}

.ach-total {
  font-size: 26rpx;
  color: #9ca3af;
  font-weight: 400;
}

.ach-bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  overflow: hidden;
  margin-top: 18rpx;
}

.ach-bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #fbbf24, #f59e0b);
}

.section-label {
  margin-top: 26rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.near-item {
  border: 1rpx solid #fde68a;
  background: #fffbeb;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.near-name {
  font-size: 28rpx;
  font-weight: 600;
}

.near-count {
  font-size: 24rpx;
  color: #b45309;
}

.near-item .bar {
  margin: 14rpx 0;
}

.near-foot {
  align-items: center;
}

.near-link {
  font-size: 24rpx;
  color: #1d4ed8;
  font-weight: 500;
}

/* 奖章格子 */
.medal-grid {
  display: flex;
  flex-wrap: wrap;
}

.medal {
  width: 31.33%;
  margin-right: 2%;
  margin-bottom: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #f3f4f6;
  border-radius: 18rpx;
  background: #fafafa;
  padding: 20rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.medal:nth-child(3n) {
  margin-right: 0;
}

.medal-earned {
  border-color: #fcd34d;
  background: linear-gradient(180deg, #fffbeb 0%, #ffffff 100%);
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.18);
}

.medal-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 44rpx;
}

.medal-icon-on {
  background: #fef3c7;
  border: 3rpx solid #fcd34d;
}

.medal-icon-off {
  background: #f3f4f6;
  opacity: 0.4;
}

.medal-name {
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #111827;
  text-align: center;
  line-height: 1.25;
}

.medal-name-locked {
  color: #9ca3af;
  font-weight: 400;
}
