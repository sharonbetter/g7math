<view class="wrap">
  <view class="hero">
    <view class="hero-title">七年级数学学习工具</view>
    <view class="hero-desc">
      依据人教版（2024）七上、七下教学大纲设计知识点课件，融合《探究应用新思维·七年级数学》的探究方法，
      提供分层考评、逐题计时、自动批改、错因分析与专项讲解—专项练习的自适应循环。
    </view>
  </view>

  <view class="stats">
    <view class="stat">
      <view class="muted">知识点总数</view>
      <view class="stat-num">{{totalPoints}}</view>
    </view>
    <view class="stat">
      <view class="muted">已学课件</view>
      <view class="stat-num blue">{{studiedCount}}</view>
    </view>
    <view class="stat">
      <view class="muted">考评轮次</view>
      <view class="stat-num">{{roundCount}}</view>
    </view>
    <view class="stat">
      <view class="muted">已掌握章节</view>
      <view class="stat-num green">{{mastered}}</view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="card-title">学习等级</view>
      <view class="muted">经验累积，长期有效</view>
    </view>
    <view class="lv-row">
      <view class="lv-medal">
        <view class="lv-medal-cap">LV</view>
        <view class="lv-medal-num">{{level}}</view>
      </view>
      <view class="lv-main">
        <view class="lv-name">{{levelName}}</view>
        <view class="row muted lv-nums">
          <text>累计 {{xpTotal}} 经验</text>
          <text>{{xpInto}} / {{xpForNext}}</text>
        </view>
        <view class="bar"><view class="bar-inner" style="width:{{xpPct}}%"></view></view>
        <view class="muted lv-next">距 Lv.{{level + 1}} {{nextLevelName}} 还差 {{xpToNext}} 经验</view>
      </view>
    </view>

    <view class="lv-rail">
      <view wx:for="{{levels}}" wx:key="level" class="lv-node">
        <view class="lv-dot {{item.current ? 'lv-dot-current' : ''}} {{item.reached ? 'lv-dot-reached' : ''}}">{{item.level}}</view>
        <view class="lv-node-name {{item.current ? 'lv-node-cur-name' : ''}}">{{item.name}}</view>
      </view>
    </view>

    <view class="lv-stats">
      <view class="lv-stat">
        <view class="muted">连续学习</view>
        <view class="lv-stat-num {{studiedToday ? 'green' : 'amber'}}">{{streak}} 天</view>
        <view class="muted">{{studiedToday ? '今天已打卡' : '今天还没学习'}}</view>
      </view>
      <view class="lv-stat">
        <view class="muted">今日目标</view>
        <view class="lv-stat-num">{{todayXp}}<text class="lv-stat-sub"> / {{dailyGoal}}</text></view>
        <view class="bar"><view class="bar-inner {{todayPct >= 100 ? 'bar-inner-green' : 'bar-inner-amber'}}" style="width:{{todayPct}}%"></view></view>
      </view>
    </view>
    <view class="muted lv-tip">学 1 个知识点 +10，交一份考评卷 +20，每答对 1 题 +2，掌握一章 +50。</view>
    <view class="gap"></view>
    <button class="btn btn-primary" bindtap="goCurriculum">{{todayXp > 0 ? '继续学习，把今天的目标做完' : '开始学习，拿今天的经验'}}</button>
  </view>

  <view class="card">
    <view class="row">
      <view>
        <view class="card-title">成就徽章</view>
        <view class="muted">达成一次就永久保留</view>
      </view>
      <view class="ach-count">{{earnedCount}}<text class="ach-total">/{{badgeTotal}}</text></view>
    </view>

    <block wx:if="{{nextBadges.length}}">
      <view class="section-label">离你最近的三枚</view>
      <view wx:for="{{nextBadges}}" wx:key="id" class="near-item">
        <view class="row">
          <view class="near-name">{{item.icon}} {{item.name}}</view>
          <view class="near-count">{{item.current}}/{{item.target}}</view>
        </view>
        <view class="bar"><view class="bar-inner {{item.pct >= 60 ? 'bar-inner-green' : 'bar-inner-amber'}}" style="width:{{item.pct}}%"></view></view>
        <view class="row near-foot">
          <text class="muted">还差 {{item.remaining}} 就能拿到</text>
          <text class="near-link" data-action="{{item.action}}" bindtap="goAction">{{item.actionLabel}} ›</text>
        </view>
      </view>
    </block>

    <view class="section-label">全部 {{badgeTotal}} 枚徽章</view>
    <view class="ach-list">
      <view wx:for="{{badges}}" wx:key="id" class="ach-item {{item.earned ? 'ach-earned' : ''}}">
        <view class="ach-icon {{item.earned ? '' : 'ach-icon-locked'}}">{{item.icon}}</view>
        <view class="ach-body">
          <view class="ach-name {{item.earned ? '' : 'ach-name-locked'}}">{{item.name}}</view>
          <view class="muted">{{item.desc}}</view>
        </view>
        <view class="ach-state {{item.earned ? 'ach-state-on' : ''}}">{{item.earned ? '已获得' : '未达成'}}</view>
      </view>
    </view>
    <view class="gap"></view>
    <button class="btn" bindtap="goProgress">查看学习报告</button>
  </view>

  <view class="card">
    <view class="row">
      <view class="card-title">四步学习闭环</view>
      <view class="badge badge-violet">自适应</view>
    </view>
    <view class="steps">
      <view class="step">
        <view class="step-no">1</view>
        <view class="step-text"><text class="strong">知识点讲解</text>：按大纲章节看课件，含概念、例题、易错与方法提炼，并附《探究应用新思维》拓展。</view>
      </view>
      <view class="step">
        <view class="step-no">2</view>
        <view class="step-text"><text class="strong">章节考评</text>：选择、填空、计算、应用四类题型，由易到难；逐题计时并自动批改。</view>
      </view>
      <view class="step">
        <view class="step-no">3</view>
        <view class="step-text"><text class="strong">耗时与错因分析</text>：实际用时比预计多用 1 分钟以上即标记；错题定位到知识点。</view>
      </view>
      <view class="step">
        <view class="step-no">4</view>
        <view class="step-text"><text class="strong">专项讲解 + 专项练习</text>：针对错题与超时题生成变式练习，循环到无错题、无超时。</view>
      </view>
    </view>
    <view class="gap"></view>
    <button class="btn btn-primary" bindtap="goCurriculum">开始学习课件</button>
    <view class="gap"></view>
    <button class="btn" bindtap="goExams">进入章节考评</button>
    <view class="gap"></view>
    <button class="btn" bindtap="goRemedial">专项提升</button>
  </view>

  <view class="card">
    <view class="card-title">学习进度</view>
    <view class="prog">
      <view class="row muted">
        <text>课件学习</text>
        <text>{{studiedCount}} / {{totalPoints}}</text>
      </view>
      <view class="bar"><view class="bar-inner" style="width:{{studiedPct}}%"></view></view>
      <view class="gap"></view>
      <view class="row muted">
        <text>章节掌握</text>
        <text>{{mastered}} / {{chapterCount}}</text>
      </view>
      <view class="bar"><view class="bar-inner bar-inner-green" style="width:{{masteredPct}}%"></view></view>
    </view>

    <view class="divider"></view>
    <view class="card-title">最近的考评</view>
    <view wx:if="{{rounds.length === 0}}" class="muted empty-tip">还没有考评记录，去「章节考评」做一套吧。</view>
    <view wx:for="{{rounds}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="openReport">
      <view class="list-title">{{item.title}}</view>
      <view class="list-right">
        <text class="muted">{{item.correct}}/{{item.total}} 正确</text>
        <view class="badge {{item.mastered ? 'badge-green' : 'badge-amber'}}">{{item.mastered ? '已掌握' : '待提升'}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">教材章节一览</view>
    <view wx:for="{{volumes}}" wx:key="id" wx:for-item="vol" class="vol">
      <view class="vol-name">{{vol.name}}</view>
      <view wx:for="{{vol.chapters}}" wx:key="id" wx:for-item="ch" class="list-item" data-id="{{ch.id}}" bindtap="openChapter">
        <view class="list-title">{{ch.no}} {{ch.title}}</view>
        <view class="list-right">
          <text class="muted">{{ch.pointCount}} 个知识点</text>
          <view wx:if="{{ch.mastered}}" class="badge badge-green">已掌握</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="card-title">当前用户</view>
      <button class="btn btn-sm" bindtap="onLogout">退出</button>
    </view>
    <view class="muted user-line">{{userLabel}}</view>
  </view>
</view>
