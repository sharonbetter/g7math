.intro {
  line-height: 1.7;
  margin-top: 10rpx;
}

.exam-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
  margin-top: 8rpx;
}

.loop-tip {
  margin-top: 16rpx;
}

.table {
  margin-top: 12rpx;
}

.tr {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.tr.th {
  border-bottom: 1rpx solid #eef0f3;
}

.tr.th .td {
  color: #9ca3af;
  font-size: 24rpx;
}

.tr.total .td {
  font-weight: 600;
  color: #111827;
  border-bottom: none;
}

.td {
  flex: 1;
  font-size: 27rpx;
  color: #374151;
}

.td.right {
  text-align: right;
  flex: 0 0 190rpx;
}

.ch-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.ch-tags .badge {
  margin: 0 12rpx 8rpx 0;
}

.rule {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
  margin-top: 12rpx;
  padding-left: 20rpx;
  position: relative;
}

.rule::before {
  content: '·';
  position: absolute;
  left: 0;
  color: #2563eb;
  font-weight: 600;
}
