.intro {
  margin-top: 12rpx;
  line-height: 1.7;
}

.chap-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
  margin-top: 6rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.prog-line {
  margin: 16rpx 0 8rpx;
}

.sec {
  padding: 0;
  overflow: hidden;
}

.sec-head {
  background: #f9fafb;
  border-bottom: 1rpx solid #f3f4f6;
  padding: 18rpx 24rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: #374151;
}

.pt {
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.pt:last-child {
  border-bottom: none;
}

.pt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pt-name {
  font-size: 29rpx;
  font-weight: 500;
  color: #1f2937;
  flex: 1;
  margin-right: 12rpx;
}

.pt-sum {
  font-size: 25rpx;
  color: #6b7280;
  line-height: 1.65;
  margin-top: 10rpx;
}

.pt-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 10rpx;
}

.ref {
  color: #8b5cf6;
}
