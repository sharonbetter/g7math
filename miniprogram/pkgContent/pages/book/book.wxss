.intro {
  margin-top: 12rpx;
  line-height: 1.7;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  font-size: 24rpx;
  color: #4b5563;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 10rpx 18rpx;
  max-width: 100%;
}

.chip-on {
  background: #eff6ff;
  border-color: #bfdbfe;
  color: #1d4ed8;
  font-weight: 500;
}

.unit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-top: 6rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.hint {
  margin: 12rpx 0;
  line-height: 1.6;
}

.page-box {
  margin-top: 16rpx;
}

.page-img {
  width: 100%;
  border-radius: 14rpx;
  border: 1rpx solid #e5e7eb;
  background: #f9fafb;
}

.page-cap {
  text-align: center;
  margin-top: 8rpx;
}

.page-text {
  margin-top: 14rpx;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  font-size: 25rpx;
  line-height: 1.75;
  color: #374151;
  white-space: pre-wrap;
}
