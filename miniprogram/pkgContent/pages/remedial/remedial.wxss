.head {
  background: #6d28d9;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}

.head .muted {
  color: #ddd6fe;
}

.head-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  margin: 10rpx 0;
}

.head-desc {
  color: #ede9fe;
  font-size: 24rpx;
  line-height: 1.7;
}

.pass {
  border-color: #bbf7d0;
  background: #f0fdf4;
  color: #166534;
}

.point-name {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.point-meta {
  margin-top: 8rpx;
}

.slide {
  border-top: 1rpx solid #f3f4f6;
  padding-top: 20rpx;
  margin-top: 20rpx;
}

.slide-kind {
  display: inline-block;
  font-size: 22rpx;
  color: #6d28d9;
  background: #f5f3ff;
  border: 1rpx solid #ddd6fe;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-bottom: 10rpx;
}

.slide-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.slide-sub {
  margin-top: 12rpx;
}

.ana {
  border-top: 1rpx solid #f3f4f6;
  padding-top: 20rpx;
  margin-top: 20rpx;
}

.ana-id {
  font-size: 24rpx;
  color: #6b7280;
}

.ana-stem {
  display: block;
  margin-top: 10rpx;
}

.ana-box {
  background: #fafafa;
  border: 1rpx solid #eef0f3;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-top: 12rpx;
}

.ana-reason {
  margin-top: 10rpx;
  color: #b91c1c;
  font-size: 26rpx;
  line-height: 1.6;
}

.ana-solution {
  margin-top: 14rpx;
}
