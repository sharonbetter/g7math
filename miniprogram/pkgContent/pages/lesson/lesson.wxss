.intro {
  margin-top: 12rpx;
  line-height: 1.7;
}

.crumb {
  margin-bottom: 8rpx;
}

.ls-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
  margin-top: 6rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.obj {
  font-size: 27rpx;
  color: #374151;
  line-height: 1.7;
  margin-top: 12rpx;
}

.kp {
  margin-top: 12rpx;
}

.kp-item {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.pt-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2937;
}

.prog-row {
  padding: 0 4rpx 16rpx;
}

.prog-bar {
  margin-top: 10rpx;
}

.slide {
  border-left: 6rpx solid #bfdbfe;
}

.slide-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.slide-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2937;
}

.ref {
  margin-top: 10rpx;
  color: #8b5cf6;
}

.body-text {
  font-size: 28rpx;
  line-height: 1.75;
  color: #374151;
  white-space: pre-wrap;
  margin-top: 14rpx;
}

.problem {
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-top: 16rpx;
}

.solution-box {
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-top: 16rpx;
}

.label.green {
  color: #15803d;
}

.notes {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.7;
  margin-top: 12rpx;
}

.cq {
  border: 1rpx solid #f3f4f6;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-top: 14rpx;
}

.cq-head {
  display: flex;
}

.cq-no {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 22rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.cq-q {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.7;
  color: #1f2937;
}

.cq-a {
  background: #f0fdf4;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  margin: 14rpx 0 0 50rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #374151;
  white-space: pre-wrap;
}

.nav-row {
  display: flex;
  gap: 12rpx;
}

.nav-btn {
  flex: 1;
  display: block;
  width: auto;
}

.nav-tip {
  margin-top: 10rpx;
}
